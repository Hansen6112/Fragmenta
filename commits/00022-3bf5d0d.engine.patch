+  U3c: false,
+  // Toxic Preparation (sang_iag_ie008): fires when the ALLY (not just
+  // the player) carries the Sanguivorum poison status — reads
+  // ally.statuses["sang_iag_poison"], same per-ally status bag as U3c.
+  U3d: false,
+};
